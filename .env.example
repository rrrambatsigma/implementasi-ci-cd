# Salin menjadi .env lalu isi nilainya. Jangan pernah commit file .env.

# NASA FIRMS MAP_KEY (wajib untuk sumber FIRMS)
FIRMS_MAP_KEY=

# Azure Storage (dipakai saat uji upload lokal, diisi pada Tahap 4)
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=scraping-results

# Opsional: OpenWeatherMap Air Pollution API
OPENWEATHER_API_KEY=
