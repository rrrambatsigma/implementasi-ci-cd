# Salin menjadi .env lalu isi nilainya. Jangan pernah commit file .env.

# NASA FIRMS MAP_KEY (wajib untuk sumber FIRMS)
FIRMS_MAP_KEY=

# Jendela data FIRMS dalam hari (1-5) dan timeout request dalam detik.
FIRMS_DAY_RANGE=2
REQUEST_TIMEOUT=60

# Jumlah hari forecast Open-Meteo dan jeda antar-request MAGMA (detik).
FORECAST_DAYS=1
MAGMA_REQUEST_DELAY=1

# Azure Storage (diisi pada Tahap 4, dipakai untuk uji upload lokal)
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=scraping-results
